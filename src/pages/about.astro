---
import "../styles/pages/about.css";
import Base from "../layouts/Base.astro";
import { PageHero } from "../components/molecules/PageHero/PageHero";
import { StatStrip } from "../components/molecules/StatStrip/StatStrip";
import { Placeholder } from "../components/atoms/Placeholder/Placeholder";
import { Eyebrow } from "../components/atoms/Eyebrow/Eyebrow";
import { PersonCard } from "../components/molecules/PersonCard/PersonCard";
import { PartnerCard } from "../components/molecules/PartnerCard/PartnerCard";
import { CtaBand } from "../components/organisms/CtaBand/CtaBand";
import { fetchDato } from "../lib/datocms";
import { ABOUT_PAGE_QUERY, type AboutPageData } from "../lib/queries/about";

const { aboutPage, siteConfig, allTeamMembers } = await fetchDato<AboutPageData>(ABOUT_PAGE_QUERY);

const managingDirector = allTeamMembers.find((member) => member.isManagingDirector)!;
const team = allTeamMembers.filter((member) => !member.isManagingDirector);

const globalStats = siteConfig.globalStats.map((stat) => ({
  ...stat,
  unit: stat.unit ?? undefined,
}));
---

<Base title="About Us" description={aboutPage.lede}>
  <PageHero
    eyebrow={aboutPage.eyebrow}
    title={aboutPage.title}
    titleMaxWidth="16ch"
    accentText={aboutPage.accent}
    description={aboutPage.lede}
  >
    <StatStrip stats={globalStats} />
  </PageHero>

  <section class="wrap section">
    <div class="two-col">
      <Placeholder label="Engineering team" height={380} rounded="lg" />
      <div class="story-grid">
        <div>
          <Eyebrow plain>{aboutPage.storyTitle}</Eyebrow>
          <hr class="rule" style="margin:var(--s-3) 0 var(--s-4)" />
          <p>{aboutPage.storyBody}</p>
        </div>
        <div>
          <Eyebrow plain>{aboutPage.visionTitle}</Eyebrow>
          <hr class="rule" style="margin:var(--s-3) 0 var(--s-4)" />
          <p>{aboutPage.visionBody}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <hr class="rule" style="margin-bottom:var(--s-7)" />
    <div class="section-label">
      <Eyebrow>{aboutPage.leadershipEyebrow}</Eyebrow>
      <p class="desc">{aboutPage.leadershipSectionDesc}</p>
    </div>
    <div class="two-col" style="align-items:start">
      <div
        class="card"
        style="display:flex; flex-wrap:wrap; gap:var(--s-5); align-items:center; box-shadow:var(--sh-2)"
      >
        <div class="avatar avatar--lg avatar--signal">{managingDirector.initials}</div>
        <div>
          <Eyebrow plain>Managing Director</Eyebrow>
          <div
            style="font-family:var(--font-display); font-weight:800; font-size:var(--t-2xl); margin-top:6px"
          >
            {managingDirector.name}
          </div>
        </div>
      </div>
      <p class="lede" style="max-width:52ch">{siteConfig.leadershipBody}</p>
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="section-label">
      <Eyebrow>{aboutPage.teamEyebrow}</Eyebrow>
      <p class="desc">{aboutPage.teamSectionDesc}</p>
    </div>
    <div class="team-grid">
      {
        team.map((member) => (
          <PersonCard name={member.name} role={member.role} initials={member.initials} />
        ))
      }
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <hr class="rule" style="margin-bottom:var(--s-7)" />
    <div class="section-label">
      <Eyebrow>{aboutPage.partnersEyebrow}</Eyebrow>
      <p class="desc">{aboutPage.partnersSectionDesc}</p>
    </div>
    <h2 class="display" style="font-size:var(--t-2xl); max-width:20ch; margin-bottom:var(--s-7)">
      {aboutPage.partnersHeading}
    </h2>
    <div class="partner-grid">
      {
        aboutPage.partners.map((partner) => (
          <PartnerCard tagLabel={partner.tagLabel} name={partner.name} meta={partner.subtitle} />
        ))
      }
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <CtaBand
      title={siteConfig.ctaBandTitle}
      description={siteConfig.ctaBandDescription}
      buttonLabel={siteConfig.ctaBandButtonLabel}
      buttonHref="/contact"
    />
  </section>
</Base>
