---
import "../styles/pages/home.css";
import Base from "../layouts/Base.astro";
import { Eyebrow } from "../components/atoms/Eyebrow/Eyebrow";
import { SignalCard } from "../components/molecules/SignalCard/SignalCard";
import { Placeholder } from "../components/atoms/Placeholder/Placeholder";
import { Button } from "../components/atoms/Button/Button";
import { LinkArrow } from "../components/atoms/LinkArrow/LinkArrow";
import { AvatarStack } from "../components/molecules/AvatarStack/AvatarStack";
import { ProjectCard } from "../components/molecules/ProjectCard/ProjectCard";
import { PersonCard } from "../components/molecules/PersonCard/PersonCard";
import { StatStrip } from "../components/molecules/StatStrip/StatStrip";
import { ServicesShowcase } from "../components/organisms/ServicesShowcase/ServicesShowcase";
import { CtaBand } from "../components/organisms/CtaBand/CtaBand";
import { fetchDato } from "../lib/datocms";
import { HOME_PAGE_QUERY, type HomePageData } from "../lib/queries/home";

const { homePage, siteConfig, allServices, allProjects, allTeamMembers } =
  await fetchDato<HomePageData>(HOME_PAGE_QUERY);

const { hero: homeHero, aboutPreview: homeAboutPreview } = homePage;

const globalStats = siteConfig.globalStats.map((stat) => ({
  ...stat,
  unit: stat.unit ?? undefined,
}));

const homeServices = allServices.map((service) => ({
  id: service.id,
  index: service.index,
  name: service.name,
  description: service.fullDescription,
}));

const homeProjects = allProjects;
const managingDirector = allTeamMembers.find((member) => member.isManagingDirector)!;
const homeTeam = allTeamMembers.filter((member) => !member.isManagingDirector).slice(0, 4);
---

<Base title="Structural Engineering & Project Consultancy">
  <section class="wrap hero">
    <div class="hero-top">
      <div class="signal-card-wrap">
        <SignalCard eyebrow={homeHero.signalEyebrow} title={homeHero.signalTitle} />
      </div>
      <p class="microcopy hero-micro">{homeHero.microcopy}</p>
    </div>

    <h1 class="hero-word">RZEST<span style="color:var(--signal)">.</span></h1>

    <div class="hero-grid">
      <div class="hero-float">
        <Placeholder
          src={homeHero.heroImage.url}
          alt={homeHero.heroImage.alt ?? "Site photo"}
          label="Site photo"
          className="hero-shot"
        />
        <p class="lede" style="max-width:38ch; margin-top:var(--s-5)">
          <span
            class="display"
            style="font-size:var(--t-xl); display:block; margin-bottom:var(--s-4)"
            >{homeHero.leadTitle}
            <span style="color:var(--ink-3)">{homeHero.leadAccent}</span></span
          >
          {homeHero.leadBody}
        </p>
        <div class="row" style="gap:var(--s-4); margin-top:var(--s-5); flex-wrap:wrap">
          <Button href="/services" variant="primary" showArrow>Explore Services</Button>
          <LinkArrow href="/projects">View projects</LinkArrow>
        </div>
      </div>

      <div class="stack" style="gap:var(--s-5)">
        <div class="hero-thumbs">
          {
            homeHero.thumbImages.map((image) => (
              <Placeholder
                src={image.url}
                alt={image.alt ?? homeHero.signalTitle}
                label={image.alt ?? homeHero.signalTitle}
                height={150}
              />
            ))
          }
        </div>
        <div class="card trust-card" style="box-shadow:var(--sh-2)">
          <div>
            <div class="row" style="gap:var(--s-3); margin-bottom:var(--s-3); flex-wrap:wrap">
              <AvatarStack
                people={allTeamMembers.slice(0, 3).map((m) => ({ initials: m.initials }))}
                maxVisible={3}
              />
              <Eyebrow plain>{homeHero.trustLabel}</Eyebrow>
            </div>
            <div class="stat">
              <div class="num">
                {homeHero.trustStat.value}<span class="unit">{homeHero.trustStat.unit}</span>
              </div>
            </div>
            <p style="font-size:var(--t-sm); margin-top:var(--s-2)">{homeHero.trustBody}</p>
          </div>
          <Placeholder
            src={homeHero.trustImage.url}
            alt={homeHero.trustImage.alt ?? homeHero.trustLabel}
            label={homeHero.trustImage.alt ?? homeHero.trustLabel}
            height={128}
            className="trust-image"
          />
        </div>
      </div>
    </div>
  </section>

  <section class="wrap">
    <hr class="rule" />
    <div class="row stats-row">
      <StatStrip stats={globalStats} />
    </div>
    <hr class="rule" />
  </section>

  <section class="wrap section">
    <div class="section-label">
      <Eyebrow>About RZest</Eyebrow>
      <p class="desc">{homePage.aboutSectionDesc}</p>
    </div>
    <div class="two-col">
      <div>
        <h2 class="display" style="font-size:var(--t-2xl)">
          {homeAboutPreview.title}
          <span style="color:var(--signal-deep)">{homeAboutPreview.titleAccent}</span> and trust.
        </h2>
        <p class="lede" style="margin-top:var(--s-5); max-width:48ch">{homeAboutPreview.body}</p>
        <Button
          href={homeAboutPreview.linkHref}
          variant="outline"
          showArrow
          style={{ marginTop: "var(--s-6)" }}
        >
          {homeAboutPreview.linkLabel}
        </Button>
      </div>
      <Placeholder
        src={homeAboutPreview.image.url}
        alt={homeAboutPreview.image.alt ?? homeAboutPreview.title}
        label={homeAboutPreview.image.alt ?? homeAboutPreview.title}
        height={340}
        rounded="lg"
      />
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="section-label">
      <Eyebrow>Our Services</Eyebrow>
      <p class="desc">{homePage.servicesSectionDesc}</p>
    </div>
    <h2 class="display" style="font-size:var(--t-2xl); max-width:18ch; margin-bottom:var(--s-7)">
      {homePage.servicesSectionHeading}
    </h2>
    <ServicesShowcase client:load services={homeServices} viewAllHref="/services" />
  </section>

  <section class="wrap section" style="padding-top:0">
    <hr class="rule" style="margin-bottom:var(--s-7)" />
    <div class="section-label">
      <Eyebrow>Our Projects</Eyebrow>
      <p class="desc">{homePage.projectsSectionDesc}</p>
    </div>
    <h2 class="display" style="font-size:var(--t-2xl); max-width:16ch; margin-bottom:var(--s-7)">
      {homePage.projectsSectionHeading}
    </h2>
    <div class="proj-grid">
      {
        homeProjects.map((project) => (
          <ProjectCard
            href={`/projects/${project.slug}`}
            title={project.title}
            meta={project.sectorLabel}
            sector={project.sector}
            thumbnailSrc={project.thumbnail.url}
          />
        ))
      }
    </div>
    <LinkArrow href="/projects" style={{ marginTop: "var(--s-6)" }}>Explore all projects</LinkArrow>
  </section>

  <section class="wrap section" style="padding-top:0">
    <hr class="rule" style="margin-bottom:var(--s-7)" />
    <div class="section-label">
      <Eyebrow>Leadership</Eyebrow>
      <p class="desc">{homePage.leadershipSectionDesc}</p>
    </div>
    <div class="two-col" style="align-items:start; margin-bottom:var(--s-7)">
      <div
        class="card"
        style="display:flex; gap:var(--s-5); align-items:center; box-shadow:var(--sh-2)"
      >
        <div class="avatar avatar--lg avatar--signal">{managingDirector.initials}</div>
        <div>
          <Eyebrow plain>Managing Director</Eyebrow>
          <div
            style="font-family:var(--font-display); font-weight:800; font-size:var(--t-xl); margin-top:6px"
          >
            {managingDirector.name}
          </div>
        </div>
      </div>
      <p class="lede" style="max-width:52ch">{siteConfig.leadershipBody}</p>
    </div>
    <div class="team-grid">
      {
        homeTeam.map((member) => (
          <PersonCard name={member.name} role={member.role} initials={member.initials} />
        ))
      }
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <CtaBand
      title={siteConfig.ctaBandTitle}
      description={siteConfig.ctaBandDescription}
      buttonLabel={siteConfig.ctaBandButtonLabel}
      buttonHref="/contact"
    />
  </section>
</Base>
