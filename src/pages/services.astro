---
import "../styles/pages/services.css";
import Base from "../layouts/Base.astro";
import { PageHero } from "../components/molecules/PageHero/PageHero";
import { StatStrip } from "../components/molecules/StatStrip/StatStrip";
import { Eyebrow } from "../components/atoms/Eyebrow/Eyebrow";
import { SignalCard } from "../components/molecules/SignalCard/SignalCard";
import { CtaBand } from "../components/organisms/CtaBand/CtaBand";
import { fetchDato } from "../lib/datocms";
import { SERVICES_PAGE_QUERY, type ServicesPageData } from "../lib/queries/services";

const { servicesPage, siteConfig, allServices } =
  await fetchDato<ServicesPageData>(SERVICES_PAGE_QUERY);

const globalStats = siteConfig.globalStats.map((stat) => ({
  ...stat,
  unit: stat.unit ?? undefined,
}));
---

<Base title="Services" description={servicesPage.lede}>
  <PageHero
    eyebrow={servicesPage.eyebrow}
    title={servicesPage.title}
    accentText={servicesPage.accentText}
    accentColor="var(--ink-3)"
    description={servicesPage.lede}
  >
    <StatStrip stats={globalStats} />
  </PageHero>

  <section class="wrap section">
    <div class="intro-grid">
      <div>
        <Eyebrow plain>Introduction</Eyebrow>
        <h2 class="display" style="font-size:var(--t-2xl); margin:var(--s-4) 0; max-width:22ch">
          {servicesPage.introTitle}
        </h2>
        <p class="lede" style="max-width:54ch">{servicesPage.introBody}</p>
      </div>
      <SignalCard eyebrow={servicesPage.signalEyebrow} title={servicesPage.signalTitle} />
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="section-label">
      <Eyebrow>{servicesPage.whatWeDoEyebrow}</Eyebrow>
      <p class="desc">{servicesPage.whatWeDoSectionDesc}</p>
    </div>
    <div class="svc-cards">
      {
        allServices.map((service) => (
          <article class="svc-card">
            <div class="idx">{service.index}</div>
            <h3>{service.name}</h3>
            <p>{service.shortDescription}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <hr class="rule" style="margin-bottom:var(--s-7)" />
    <div class="section-label">
      <Eyebrow>{servicesPage.approachEyebrow}</Eyebrow>
      <p class="desc">{servicesPage.approachSectionDesc}</p>
    </div>
    <h2 class="display" style="font-size:var(--t-2xl); max-width:20ch; margin-bottom:var(--s-7)">
      {servicesPage.processTitle}
    </h2>
    <div class="process">
      {
        servicesPage.processSteps.map((step) => (
          <div class="step">
            <div class="n">{step.number}</div>
            <div class="nm">{step.label}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <CtaBand
      variant="ink"
      title={siteConfig.ctaBandTitle}
      description={siteConfig.ctaBandDescription}
      buttonLabel={siteConfig.ctaBandButtonLabel}
      buttonHref="/contact"
    />
  </section>
</Base>
