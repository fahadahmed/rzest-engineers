---
import "../../styles/pages/project-detail.css";
import Base from "../../layouts/Base.astro";
import { Breadcrumb } from "../../components/molecules/Breadcrumb/Breadcrumb";
import { Tag } from "../../components/atoms/Tag/Tag";
import { Placeholder } from "../../components/atoms/Placeholder/Placeholder";
import { Eyebrow } from "../../components/atoms/Eyebrow/Eyebrow";
import { ProjectFacts } from "../../components/molecules/ProjectFacts/ProjectFacts";
import { LinkArrow } from "../../components/atoms/LinkArrow/LinkArrow";
import { CtaBand } from "../../components/organisms/CtaBand/CtaBand";
import { fetchDato } from "../../lib/datocms";
import {
  ALL_PROJECTS_QUERY,
  PROJECTS_PAGE_QUERY,
  type AllProjectsData,
  type ProjectRecord,
  type ProjectsPageData,
} from "../../lib/queries/projects";

export async function getStaticPaths() {
  const { allProjects: projects } = await fetchDato<AllProjectsData>(ALL_PROJECTS_QUERY);
  const { siteConfig } = await fetchDato<ProjectsPageData>(PROJECTS_PAGE_QUERY);

  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: projects[(index + 1) % projects.length],
      siteConfig,
    },
  }));
}

interface Props {
  project: ProjectRecord;
  next: ProjectRecord;
  siteConfig: ProjectsPageData["siteConfig"];
}

const { project, next, siteConfig } = Astro.props;

const overviewParagraphs = project.overview.split("\n").filter((paragraph) => paragraph.trim());

const facts = [
  { key: "Client", value: project.client },
  { key: "Sector", value: project.sectorLabel },
  { key: "Type", value: project.projectType },
  { key: "Location", value: project.location },
  { key: "Role", value: project.role },
  { key: "Status", value: project.projectStatus },
];

const projectJsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.tagline,
  image: project.heroImage.url,
  about: project.sectorLabel,
  locationCreated: project.location,
  provider: {
    "@type": "Organization",
    name: "RZest Engineers",
  },
};
---

<Base title={project.title} description={project.tagline} ogImage={project.heroImage.url} ogType="article">
  <script type="application/ld+json" is:inline set:html={JSON.stringify(projectJsonLd)} />
  <section class="wrap">
    <Breadcrumb items={[{ label: "Projects", href: "/projects" }, { label: project.title }]} />
    <div class="detail-title">
      <div class="row" style="gap:var(--s-3); flex-wrap:wrap">
        <Tag variant="solid">{project.sectorLabel}</Tag>
        <Tag variant="ghost">{project.projectType}</Tag>
      </div>
      <h1 class="display">{project.title}</h1>
      <p class="lede" style="max-width:48ch">{project.tagline}</p>
    </div>
    <Placeholder
      src={project.heroImage.url}
      alt={project.heroImage.alt ?? project.title}
      label="Project hero photo"
      rounded="lg"
      className="hero-shot"
    />
  </section>

  <section class="wrap section" style="padding-top:0">
    <div class="body-grid">
      <div>
        <Eyebrow plain>Overview</Eyebrow>
        <hr class="rule" style="margin:var(--s-3) 0 var(--s-5)" />
        {overviewParagraphs.map((paragraph) => <p style="margin-bottom:var(--s-5)">{paragraph}</p>)}

        <Eyebrow plain>Scope of Engineering</Eyebrow>
        <hr class="rule" style="margin:var(--s-3) 0 var(--s-5)" />
        <div class="row" style="gap:var(--s-3); flex-wrap:wrap">
          {project.scopeItems.map((item) => <Tag>{item.field}</Tag>)}
        </div>

        <div class="gallery" style="margin-top:var(--s-8)">
          {
            project.gallery.map((image) => (
              <Placeholder
                src={image.url}
                alt={image.alt ?? project.title}
                label={image.alt ?? project.title}
                height={160}
              />
            ))
          }
        </div>
      </div>

      <ProjectFacts facts={facts} ctaLabel="Discuss a similar project" ctaHref="/contact" />
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <hr class="rule" style="margin-bottom:var(--s-6)" />
    <div class="nextprev">
      <LinkArrow href="/projects" showArrow={false}>← All projects</LinkArrow>
      <LinkArrow href={`/projects/${next.slug}`} showArrow={false}>Next: {next.title} →</LinkArrow>
    </div>
  </section>

  <section class="wrap section" style="padding-top:0">
    <CtaBand
      title={siteConfig.ctaBandTitle}
      description={siteConfig.ctaBandDescription}
      buttonLabel={siteConfig.ctaBandButtonLabel}
      buttonHref="/contact"
    />
  </section>
</Base>
